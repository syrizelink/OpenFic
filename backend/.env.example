# Contoh konfigurasi environment OpenFic.
#
# Salin berkas ini ke lokasi yang benar-benar dibaca aplikasi, yaitu
# ``<OPENFIC_DATA_DIR>/.env``. Bila OPENFIC_DATA_DIR tidak diset, lokasinya
# adalah ``backend/data/.env``.
#
#   cp backend/.env.example backend/data/.env
#
# Semua nilai di bawah bersifat opsional; yang dikomentari menunjukkan nilai
# bawaan. Jangan pernah memasukkan kredensial nyata ke berkas contoh ini.


# ---------------------------------------------------------------------------
# Lokasi data
# ---------------------------------------------------------------------------

# Direktori induk untuk openfic.db, checkpoints.db, indeks retrieval, .env, dan
# .key. Dibaca sebagai variabel proses (bukan dari .env), jadi setel lewat
# systemd atau shell bila ingin memindahkannya.
# OPENFIC_DATA_DIR=/var/lib/openfic


# ---------------------------------------------------------------------------
# Mesin retrieval
# ---------------------------------------------------------------------------

# Mode keyword-only untuk lingkungan tanpa dukungan CPU x86-64-v2 (AVX).
#
# false (bawaan)  : memakai LanceDB. Mendukung pencarian vektor/semantik, tetapi
#                   menuntut AVX melalui numpy dan pyarrow. Proses akan mati
#                   dengan SIGILL pada CPU yang hanya mendukung SSE2.
# true            : memakai adapter SQLite FTS5 yang murni Python. Tidak ada
#                   pustaka native yang dimuat sama sekali.
#
# Konsekuensi saat true: pencarian bab berbasis kata kunci (BM25), bukan
# semantik. Kueri "sebutkan pedang" berfungsi; "adegan bernuansa perpisahan"
# tidak. Fitur model lokal lain juga dinonaktifkan.
#
# Peralihan nilai ini mengubah bentuk kontrak indeks, sehingga indeks yang sudah
# ada akan ditandai needs_rebuild dan dibangun ulang.
# OPENFIC_CLOUD_ONLY=false


# ---------------------------------------------------------------------------
# Autentikasi
# ---------------------------------------------------------------------------

# Kata sandi tunggal untuk membuka aplikasi. Kosong atau tidak diset berarti
# tanpa gerbang autentikasi - jangan biarkan kosong bila instans dapat diakses
# dari internet.
# OPENFIC_AUTH_PASSWORD=


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
