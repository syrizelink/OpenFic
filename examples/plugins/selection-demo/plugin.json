{
  "id": "selection-demo",
  "name": "选区与引用示例",
  "version": "1.0.0",
  "api_version": 1,
  "description": "演示选区来源、菜单触发方式、选区读取和带提示词的 Agent 引用。",
  "author": "OpenFic",
  "entry": "main.py",
  "resources": [],
  "capabilities": ["ui", "selection.read"],
  "views": [
    {
      "id": "inspect-selection",
      "title": "示例：检查选区（松开）",
      "slot": "selection.menu",
      "renderer": "declarative",
      "presentation": "action",
      "action": "selection.action",
      "selectionTriggers": ["selection"],
      "selectionSources": ["chapter", "note", "character", "world-info", "agent-input"]
    },
    {
      "id": "inspect-message",
      "title": "示例：检查选区（松开）",
      "icon": "Search",
      "slot": "selection.menu",
      "renderer": "declarative",
      "presentation": "action",
      "action": "selection.action",
      "selectionTriggers": ["selection"],
      "selectionSources": ["agent-message"]
    },
    {
      "id": "inspect-contextmenu",
      "title": "示例：检查选区（右键）",
      "slot": "selection.menu",
      "renderer": "declarative",
      "presentation": "action",
      "action": "selection.action",
      "selectionTriggers": ["contextmenu"],
      "selectionSources": ["chapter", "note", "character", "world-info", "agent-message", "agent-input"]
    },
    {
      "id": "quote",
      "title": "示例：引用到 Agent",
      "icon": "Quote",
      "slot": "selection.menu",
      "renderer": "declarative",
      "presentation": "action",
      "action": "selection.action",
      "selectionTriggers": ["selection", "contextmenu"],
      "selectionSources": ["chapter", "note", "character", "world-info", "agent-message", "agent-input"]
    }
  ],
  "settings": [
    {
      "key": "quotePrompt",
      "label": "引用提示词",
      "type": "string",
      "default": "请结合上下文分析这段引用，指出值得注意的细节。"
    }
  ]
}
