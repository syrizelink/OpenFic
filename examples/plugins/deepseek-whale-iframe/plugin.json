{
  "id": "deepseek-whale-iframe",
  "name": "DeepSeek 小鲸鱼（iframe）",
  "version": "1.0.0",
  "api_version": 1,
  "description": "参考上游小鲸鱼的 iframe 桌宠，显示余额、观测消费和回合费用。",
  "author": "OpenFic; original widget and artwork by MeteorNOX",
  "entry": "main.py",
  "resources": ["assets"],
  "capabilities": ["ui", "ui.overlay", "storage", "secrets", "network", "timers", "events", "agent.hooks"],
  "network_hosts": ["api.deepseek.com"],
  "views": [
    {"id": "widget", "title": "DeepSeek 小鲸鱼", "slot": "app.overlay", "renderer": "iframe", "entry": "assets/index.html"},
    {"id": "test-dialog", "title": "小鲸鱼弹窗测试", "slot": "app.overlay", "renderer": "iframe", "entry": "assets/overlay-test.html", "presentation": "dialog", "height": 180},
    {"id": "test-popover", "title": "小鲸鱼浮层测试", "slot": "app.overlay", "renderer": "iframe", "entry": "assets/overlay-test.html", "presentation": "popover", "height": 180}
  ],
  "settings": [
    {"key": "apiKey", "label": "DeepSeek API Key", "type": "string", "default": "", "secret": true},
    {"key": "lowBalance", "label": "低余额提醒阈值", "type": "number", "default": 5, "minimum": 0},
    {"key": "budget", "label": "每日观测消费预算（0 关闭）", "type": "number", "default": 0, "minimum": 0}
  ]
}
